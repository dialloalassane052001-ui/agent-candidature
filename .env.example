# Copie ce fichier en ".env" et remplis ta cle API Google Gemini.
# Cle GRATUITE a creer sur https://aistudio.google.com/apikey

GEMINI_API_KEY=colle-ta-cle-gemini-ici

# Modele Gemini a utiliser.
#   gemini-2.5-flash       -> par defaut, bon equilibre qualite / gratuit
#   gemini-2.5-flash-lite  -> plus rapide / plus econome
#   gemini-2.5-pro         -> plus puissant (quota gratuit plus limite)
GEMINI_MODELE=gemini-2.5-flash

# (Optionnel) Dossier contenant tes CV.
# Par defaut : le dossier "Candidatures_2026" a cote de ce projet.
# DOSSIER_CV=D:\Mon Projet Personel\Candidatures_2026
